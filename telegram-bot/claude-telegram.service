[Unit]
Description=Claude Code Telegram Bot
After=network.target

[Service]
Type=simple
User=jmax
WorkingDirectory=/home/jmax/jmax/telegram-bot
EnvironmentFile=/home/jmax/jmax/telegram-bot/.env
ExecStart=/home/jmax/jmax/telegram-bot/venv/bin/python3 /home/jmax/jmax/telegram-bot/bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
